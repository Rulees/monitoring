server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /positions.yml


# Куда отправлять логи
clients:
  - url: "http://{{ MONITORING_SERVER_IP }}:3100/loki/api/v1/push"           # из ansible/inventory/group_vars/all/main.yml
    external_labels:
        project_name: "{{ PROJECT_NAME }}"                                   # из monitoring/projects/<project>/inventory.yml



# Откуда забирать логи
scrape_configs:
  - job_name: nginx
    static_configs:
      - targets: [localhost]
        labels:
          job: nginx
          __path__: /var/log/nginx/*.log
    pipeline_stages:
      - json:
          expressions:
            remote_addr: remote_addr
  

  - job_name: apache
    static_configs:
      - targets: [localhost]
        labels:
          job: apache
          __path__: /var/log/apache2/*.log

  - job_name: system
    static_configs:
    - targets: [localhost]
      labels:
        job: varlogs
        __path__: /var/log/*log

  - job_name: docker  
    static_configs:
    - targets: [localhost]
      labels:
        job: docker
        __path__: /var/lib/docker/containers/*/*.log
    pipeline_stages:
      - docker: {}

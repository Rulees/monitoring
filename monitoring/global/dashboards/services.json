              { "id": "custom.align", "value": "center" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "value": null, "color": "red" },
                    { "value": 10, "color": "orange" },
                    { "value": 20, "color": "green" }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "N" },

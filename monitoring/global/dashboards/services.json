              { "id": "custom.width", "value": 95 },
              { "id": "custom.align", "value": "center" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "value": null, "color": "green" },
                    { "value": 70, "color": "orange" },
                    { "value": 85, "color": "red" }
                  ]
                }
              }
            ]
          },

          {
            "matcher": { "id": "byName", "options": "DISK" },
